# Copy to .env on your own computer and enter your key there.
# .env is ignored by Git and is never served to the browser or bundled.
EVOLUS_API_KEY=

# This project's configured agent. No manual model lookup is needed.
EVOLUS_AGENT_ID=405d18ba-6acf-43cd-9d76-7eddb9710603

# Normally leave this blank. The backend discovers applicationId:agentId.
# The underlying model name own/gemma-4-31b-it is NOT the API routing ID.
EVOLUS_MODEL=
PORT=8000

# Hosted deployments only: keep the key on the hosting service, never GitHub.
# Render supplies RENDER_EXTERNAL_URL automatically.
# ECHOSPHERE_HOSTED=true
# PUBLIC_ORIGIN=https://your-app.example
# MAX_AGENT_CALLS_PER_HOUR=60
